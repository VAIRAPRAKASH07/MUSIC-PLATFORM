# ==============================================================================
# Music Platform Environment Configuration Example
# Copy this file to .env and fill in your actual credentials.
# NOTE: .env is ignored by git to protect credentials.
# ==============================================================================

# Database Connection (Required in production)
DB_URL=jdbc:mysql://localhost:3306/music_platform?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USER=root
DB_PASS=your_db_password

# ==============================================================================
# Cloud Managed MySQL SSL URL Configurations
# ==============================================================================
# 1. Aiven for MySQL:
#    Aiven requires SSL connections. Add sslMode=REQUIRED or sslMode=VERIFY_CA
#    Example:
#    DB_URL=jdbc:mysql://mysql-instance-name.aivencloud.com:12345/music_platform?sslMode=REQUIRED
#
# 2. TiDB Cloud (Serverless or Dedicated):
#    TiDB Cloud requires secure TLS. Add sslMode=VERIFY_IDENTITY
#    Example:
#    DB_URL=jdbc:mysql://gateway01.us-east-1.prod.aws.tidbcloud.com:4000/music_platform?sslMode=VERIFY_IDENTITY&ssl-mode=REQUIRED
# ==============================================================================

# Server Configuration
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev
